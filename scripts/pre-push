#!/usr/bin/env bash
# Read Git's ref-update stream; gate each non-deletion local commit in isolation.
set -euo pipefail
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE DISPLAY WAYLAND_DISPLAY DBUS_SESSION_BUS_ADDRESS BROWSER
script_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
root="$(git -C "$script_dir" rev-parse --show-toplevel)"
export TMPDIR="$root/.tmp"
mkdir -p "$TMPDIR"
shas=()
updates=0
if [ ! -t 0 ]; then
  while read -r -t 10 local_ref local_sha remote_ref remote_sha; do
    updates=$((updates+1))
    case "$local_sha" in
      0000000000000000000000000000000000000000) continue;;
      ''|*[!0-9a-f]*) echo "invalid pushed SHA: $local_sha" >&2; exit 1;;
    esac
    shas+=("$(git -C "$root" rev-parse --verify "${local_sha}^{commit}")")
  done
fi
if [ "$updates" -eq 0 ]; then
  shas=("$(git -C "$root" rev-parse --verify HEAD)")
fi
for sha in "${shas[@]}"; do
  wt="$(mktemp -d "$TMPDIR/push-$sha-XXXXXXXX")"
  cleanup() {
    git -C "$root" worktree remove --force "$wt"
  }
  git -C "$root" worktree add --detach "$wt" "$sha"
  trap cleanup EXIT
  echo "pre-push: gate pushed commit $sha in $wt" >&2
  mkdir -p "$wt/.tmp"
  env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE \
    -u DISPLAY -u WAYLAND_DISPLAY -u DBUS_SESSION_BUS_ADDRESS -u BROWSER \
    TMPDIR="$wt/.tmp" "$wt/scripts/gate"
  cleanup
  trap - EXIT
done
